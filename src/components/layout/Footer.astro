---
import { menuLinks, resourceLinks, siteConfig } from "@/site.config";

const year = new Date().getFullYear();
---

<footer
	class="mt-auto flex w-full flex-col gap-y-4 pt-20 pb-4 text-center text-sm text-zinc-600 sm:text-xs dark:text-zinc-400"
>
	<div class="flex flex-col items-center justify-between gap-3 sm:flex-row">
		<p>&copy; {year} {siteConfig.author}</p>
		<nav aria-label="Footer" class="flex flex-wrap justify-center gap-x-4 gap-y-1">
			{
				menuLinks.map((link) => (
					<a class="hover:text-accent hover:underline" href={link.path}>
						{link.title}
					</a>
				))
			}
		</nav>
	</div>
	<nav aria-label="Resources" class="flex flex-wrap justify-center gap-x-4 gap-y-1">
		{
			resourceLinks.map((link) => (
				<a
					class="hover:text-accent hover:underline"
					href={link.path}
					rel={link.external ? "noreferrer" : undefined}
					target={link.external ? "_blank" : undefined}
				>
					{link.title}
					{link.external && <span aria-hidden="true"> ↗</span>}
				</a>
			))
		}
	</nav>
</footer>
