---
import { getCollection } from "astro:content";
import Search from "@/components/Search.astro";
import PageLayout from "@/layouts/Base.astro";

const allNotes = await getCollection("note");

const formatTitle = (value: string) =>
	value.replace(/-/g, " ").replace(/\b\w/g, (letter) => letter.toUpperCase());

const books = new Map<string, typeof allNotes>();
const categories = new Map<string, typeof allNotes>();

for (const note of allNotes) {
	const category = note.data.category ?? "other";

	if (category === "books" && note.id.includes("/")) {
		const book = note.id.split("/")[0];
		if (!book) continue;
		books.set(book, [...(books.get(book) ?? []), note]);
		continue;
	}

	categories.set(category, [...(categories.get(category) ?? []), note]);
}

const bookEntries = [...books.entries()].flatMap(([book, chapters]) => {
	const firstChapter = [...chapters].sort(
		(a, b) => (a.data.chapter ?? 0) - (b.data.chapter ?? 0),
	)[0];
	return firstChapter ? [{ book, firstChapter, title: formatTitle(book) }] : [];
});

const categoryEntries = [...categories.entries()]
	.filter(([category]) => category !== "books")
	.sort(([a], [b]) => a.localeCompare(b));

const getCategoryTitle = (category: string) => {
	if (category === "books") return "Reading notes";
	if (category === "other") return "Miscellaneous";
	return formatTitle(category);
};

const certificationNotesUrl = "https://notes.monitus.org";

const meta = {
	description: "Reading notes and study notes by Tommy Cheung.",
	title: "Notes",
};
---

<PageLayout meta={meta}>
	<section>
		<div class="mb-6 flex items-start justify-between gap-4">
			<h1 class="title">Notes</h1>
			<Search />
		</div>
		<p class="mb-12 max-w-2xl text-sm leading-relaxed text-zinc-600 dark:text-zinc-300">
			Notes from books and courses I am working through. Longer certification notes live on
			<a
				class="cactus-link"
				href={certificationNotesUrl}
				rel="noreferrer"
				target="_blank">notes.monitus.org</a
			>.
		</p>

		{
			bookEntries.length > 0 && (
				<section class="mb-12">
					<h2 class="mb-6 text-2xl font-semibold">Reading notes</h2>
					<ul class="space-y-4">
						{bookEntries.map(({ firstChapter, title }) => (
							<li>
								<a class="cactus-link text-lg" href={`/notes/${firstChapter.id}/`}>
									{title}
								</a>
							</li>
						))}
					</ul>
				</section>
			)
		}

		{
			categoryEntries.map(([category, notes]) => (
				<section class="mb-12">
					<h2 class="mb-6 text-2xl font-semibold">{getCategoryTitle(category)}</h2>
					<ul class="space-y-4">
						{notes.map((note) => (
							<li>
								<a class="cactus-link" href={`/notes/${note.id}/`}>
									{note.data.title}
								</a>
							</li>
						))}
					</ul>
				</section>
			))
		}
	</section>
</PageLayout>
