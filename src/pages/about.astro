---
import { Icon } from "astro-icon/components";
import skillsData from "@/content/skills.json";
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description:
		"Tommy Cheung is an AWS-certified AI engineer with a data science background and a previous career in audit.",
	title: "About",
};

const certifications = [
	{
		name: "AWS Certified Machine Learning Engineer – Associate",
		code: "MLA-C02",
		issuer: "Amazon Web Services",
	},
	{
		name: "AWS Certified AI Practitioner",
		code: "AIF-C01",
		issuer: "Amazon Web Services",
	},
	{
		name: "AWS Certified Cloud Practitioner",
		code: "CLF-C02",
		issuer: "Amazon Web Services",
	},
];

const previousCertifications = [
	{
		name: "Microsoft Certified: Azure Data Scientist Associate",
		code: "DP-100",
		issuer: "Microsoft",
		status: "Expired 2026",
	},
];

const timeline = [
	{
		period: "2024–2025",
		title: "MSc in Data Science",
		organization: "University of Colorado Boulder",
	},
	{
		period: "2021–2023",
		title: "AI Engineer",
		organization: "Agile Extreme Lab",
	},
	{
		period: "Mar–Aug 2021",
		title: "Data Science & Machine Learning Immersive",
		organization: "Xccelerate · Full-time",
	},
	{
		period: "2016–2020",
		title: "Auditor → Senior Auditor",
		organization: "Ernst & Young",
	},
	{
		period: "2012–2016",
		title: "BBA in Professional Accountancy",
		organization: "The Chinese University of Hong Kong",
	},
];

const hobbies = [
	{ label: "Calligraphy", icon: "fluent:calligraphy-pen-20-filled" },
	{ label: "Coffee Brewing", icon: "mdi:coffee" },
	{ label: "Gaming", icon: "simple-icons:steam" },
];
---

<PageLayout meta={meta}>
	<section class="mb-16">
		<h1 class="mb-6 text-3xl font-bold">About</h1>
		<div class="max-w-2xl space-y-4 leading-relaxed text-zinc-600 dark:text-zinc-300">
			<p>
				I am an AI engineer with a data science background. My path here was not planned: I
				started in accounting and audit, moved into data science, and then into building AI
				products.
			</p>
			<p>
				That route taught me to care about the unglamorous parts — clean data, clear
				measurement, and systems that keep working after the demo. I like turning ambiguous
				problems into something small enough to test, then iterating until it is genuinely
				useful.
			</p>
		</div>
	</section>

	<section class="mb-16">
		<h2 class="mb-6 text-2xl font-semibold">Career snapshot</h2>
		<ol class="space-y-5 border-l-2 border-accent/40 pl-6">
			{
				timeline.map((item) => (
					<li class="relative">
						<span class="absolute -left-[1.9rem] top-1.5 h-2.5 w-2.5 rounded-full bg-accent" />
						<p class="text-xs font-semibold text-accent">{item.period}</p>
						<p class="font-medium">{item.title}</p>
						<p class="text-sm text-zinc-600 dark:text-zinc-400">{item.organization}</p>
					</li>
				))
			}
		</ol>
	</section>

	<section class="mb-16">
		<h2 class="mb-6 text-2xl font-semibold">Certifications</h2>
		<ul class="space-y-3">
			{
				certifications.map((certification) => (
					<li class="rounded-lg border border-zinc-200 p-4 dark:border-zinc-800">
						<div class="flex flex-wrap items-baseline justify-between gap-2">
							<p class="font-medium">{certification.name}</p>
							<span class="rounded bg-accent/15 px-2 py-0.5 text-xs font-medium text-accent-2">
								{certification.code}
							</span>
						</div>
						<p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">{certification.issuer}</p>
					</li>
				))
			}
		</ul>
		{
			previousCertifications.length > 0 && (
				<div class="mt-6">
					<h3 class="mb-3 text-sm font-semibold text-accent">Previously held</h3>
					<ul class="space-y-3">
						{previousCertifications.map((certification) => (
							<li class="rounded-lg border border-dashed border-zinc-300 p-4 dark:border-zinc-700">
								<div class="flex flex-wrap items-baseline justify-between gap-2">
									<p class="font-medium text-zinc-700 dark:text-zinc-300">
										{certification.name}
									</p>
									<span class="rounded bg-zinc-200 px-2 py-0.5 text-xs font-medium text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400">
										{certification.code}
									</span>
								</div>
								<p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">
									{certification.issuer} · {certification.status}
								</p>
							</li>
						))}
					</ul>
				</div>
			)
		}
		<p class="mt-3 text-xs text-zinc-600 dark:text-zinc-400">
			Verification details available on request.
		</p>
	</section>

	<section class="mb-16">
		<h2 class="mb-4 text-2xl font-semibold">How I work</h2>
		<ul class="max-w-2xl list-inside list-disc space-y-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-300">
			<li>Start from the user problem, not the model or the framework.</li>
			<li>Make the result measurable, then keep the feedback loop short.</li>
			<li>Build for the whole path: data, evaluation, deployment, and the interface.</li>
		</ul>
	</section>

	<section class="mb-16">
		<h2 class="mb-6 text-2xl font-semibold">Skills</h2>
		<div class="space-y-5">
			{
				skillsData.map((category) => (
					<div>
						<h3 class="mb-2 text-sm font-semibold text-accent">{category.title}</h3>
						<ul class="flex flex-wrap gap-1.5">
							{category.skills.map((skill) => (
								<li class="inline-flex items-center rounded bg-zinc-200/70 px-2 py-1 text-xs text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">
									<Icon name={skill.icon} class="mr-1.5 h-4 w-4" />
									{skill.name}
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</section>

	<section>
		<h2 class="mb-4 text-2xl font-semibold">Outside work</h2>
		<ul class="flex flex-wrap gap-2">
			{
				hobbies.map((hobby) => (
					<li class="inline-flex items-center rounded-full bg-accent/15 px-3 py-1 text-sm font-medium text-accent-2">
						<Icon name={hobby.icon} class="mr-2 h-5 w-5" />
						{hobby.label}
					</li>
				))
			}
		</ul>
	</section>
</PageLayout>
